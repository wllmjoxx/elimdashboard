# Server .env for staging (and, with APP_ENV=production, the live site).
# provision.sh copies this to .env and fills APP_URL and APP_ENV; deploy.sh
# generates APP_KEY. Fill in the mail settings by hand. Never commit .env.

APP_NAME="GGP Elim"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://staging.example.org

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# SQLite is enough for staging. Production uses MySQL/MariaDB (PRD 4.11):
# DB_CONNECTION=mysql, DB_HOST, DB_PORT, DB_DATABASE, DB_USERNAME, DB_PASSWORD.
DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Sign-in codes and approval emails. Gmail works for staging with an App
# Password; production uses a transactional service on the church domain.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Cloudflare Turnstile for public forms (Form Doa, Kesaksian). Empty = off.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
