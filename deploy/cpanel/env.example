# .env for cPanel shared hosting (DomaiNesia). install.sh copies this to .env
# and fills APP_KEY. Fill in APP_URL, DB_* and MAIL_* by hand in File Manager.
# Never commit .env.

APP_NAME="GGP Elim"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# The subdomain first (https://baru.ggpelim.com), later https://ggpelim.com.
APP_URL=

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# cPanel › Manage My Databases. cPanel prefixes names with the account
# user, e.g. ggpelimc_elim.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
CACHE_STORE=database

# No Supervisor on shared hosting: the scheduler cron (every minute) starts a
# worker that sends queued emails and stops. Sign-in codes go right after
# the response and do not wait for it.
QUEUE_CONNECTION=database
QUEUE_WORK_VIA_SCHEDULER=true

# An email account made in cPanel › Email Accounts, e.g.
# noreply@ggpelim.com. Server: mail.ggpelim.com, SSL port 465.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.ggpelim.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Cloudflare Turnstile for public forms (Form Doa, Kesaksian). Empty = off.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
