<?php

use App\Modules\{{ Name }}\Http\Controllers\{{ Name }}Controller;
use Illuminate\Support\Facades\Route;

// Routes of the {{ title }} module. Loaded with the "web" middleware group.
// Keep every route name under the "{{ key }}." prefix.

Route::middleware(['auth', 'verified'])
    ->prefix('admin/{{ key }}')
    ->name('{{ key }}.')
    ->group(function () {
        Route::get('/', [{{ Name }}Controller::class, 'index'])->name('index');
    });
